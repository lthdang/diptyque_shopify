{% comment %} ── Order history + Order detail styles ───────────────────────── {% endcomment %}
{% stylesheet %}

  /* ================================================================
     Order History — tabs, cards, status badges, load-more
     (mirrors sections/order-history.liquid styles for /pages/account)
     ================================================================ */

  /* ─── Tabs ─── */
  .order-history__tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid #e6e6e6;
    margin-bottom: 24px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .order-history__tabs::-webkit-scrollbar { display: none; }

  .order-history__tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 16px;
    font-size: 0.8rem;
    font-family: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
    color: #999;
    white-space: nowrap;
    margin-bottom: -1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .order-history__tab.is-active {
    color: var(--color-foreground, #000);
    border-bottom-color: var(--color-foreground, #000);
  }

  .order-history__tab:hover { color: var(--color-foreground, #000); }

  /* ─── Order list ─── */
  .order-history__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── Order card (accordion design) ─── */
  .order-history__notice {
    font-size: 0.78rem;
    color: #666;
    margin: 0 0 24px;
    line-height: 1.6;
  }

  .order-history__card {
    display: block;
    padding: 20px 0;
    border-bottom: 1px solid #e6e6e680;
  }

  .order-history__card:first-child { border-top: 1px solid #e6e6e680; }

  /* ─── Header row: status badge LEFT, date RIGHT ─── */
  .order-history__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 14px;
  }

  .order-history__date {
    font-size: 0.8rem;
    color: #666;
    margin: 0;
    flex-shrink: 0;
  }

  /* ─── Card body: thumbnail (left) + info (right) ─── */
  .order-history__card-body {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .order-history__card-thumb {
    position: relative;
    flex-shrink: 0;
    width: 100px;
    height: 100px;
  }

  .order-history__card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .order-history__card-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  .order-history__card-thumb-count {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(0,0,0,0.55);
    color: #fff;
    font-size: 0.65rem;
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    line-height: 1;
  }

  .order-history__card-info {
    flex: 1;
    min-width: 0;
  }

  .order-history__order-id {
    font-size: 0.85rem;
    margin: 0 0 8px;
  }

  .order-history__order-id strong { font-weight: 600; }

  .order-history__tracking {
    font-size: 0.8rem;
    margin: 0 0 14px;
  }

  .order-history__tracking a {
    color: var(--color-foreground, #000);
    text-decoration: underline;
  }

  .order-history__tracking--unavailable { color: #999; }

  /* ─── Toggle button ─── */
  .order-history__toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    font-size: 0.82rem;
    font-family: inherit;
    letter-spacing: 0.03em;
    cursor: pointer;
    padding: 0;
    color: var(--color-foreground, #000);
  }

  .order-history__toggle-arrow {
    font-size: 0.65rem;
    transition: transform 0.25s ease;
    display: inline-block;
  }

  .order-history__toggle.is-open .order-history__toggle-arrow {
    transform: rotate(90deg);
  }

  /* ─── Expandable detail (indented to align with info column) ─── */
  .order-history__detail {
    display: none;
    margin-top: 24px;
    padding-left: 120px; /* 100px thumb + 20px gap */
  }

  .order-history__detail.is-open { display: block; }

  @media screen and (max-width: 749px) {
    .order-history__detail { padding-left: 0; }
  }

  /* ─── Line items ─── */
  .order-history__items {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e6e6e680;
  }

  .order-history__item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .order-history__item-image {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    background: #f5f5f5;
  }

  .order-history__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .order-history__item-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
  }

  .order-history__item-info { flex: 1; min-width: 0; }

  .order-history__item-name {
    font-size: 0.85rem;
    font-weight: 500;
    margin: 0 0 4px;
  }

  .order-history__item-variant,
  .order-history__item-meta {
    font-size: 0.78rem;
    color: #666;
    margin: 0 0 2px;
  }

  .order-history__item-price {
    font-size: 0.85rem;
    white-space: nowrap;
    margin: 0;
    flex-shrink: 0;
  }

  /* ─── Addresses ─── */
  .order-history__addresses {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e6e6e680;
  }

  .order-history__address-title {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0 0 8px;
    letter-spacing: 0.03em;
  }

  .order-history__address-body,
  .order-history__shipping-time {
    font-size: 0.78rem;
    color: #444;
    line-height: 1.7;
    margin: 0;
  }

  .order-history__shipping-time { margin-top: 8px; color: #666; }

  /* ─── Payment ─── */
  .order-history__payment {
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid #e6e6e680;
  }

  .order-history__payment-title {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0 0 12px;
    letter-spacing: 0.03em;
  }

  .order-history__payment-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    margin-bottom: 6px;
  }

  .order-history__payment-row--total {
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #e6e6e680;
  }

  /* ─── Detail actions ─── */
  .order-history__detail-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .order-history__receipt-btn {
    display: block;
    width: 100%;
    padding: 14px;
    text-align: center;
    border: 1px solid var(--color-foreground, #000);
    font-size: 0.82rem;
    font-family: inherit;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-foreground, #000);
    background: #fff;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .order-history__receipt-btn:hover {
    background: var(--color-foreground, #000);
    color: #fff;
  }

  .order-history__reorder-link {
    background: none;
    border: none;
    font-size: 0.82rem;
    font-family: inherit;
    cursor: pointer;
    text-decoration: underline;
    color: var(--color-foreground, #000);
    padding: 0;
  }

  @media screen and (max-width: 749px) {
    .order-history__addresses { grid-template-columns: 1fr; }
  }

  /* ─── Status badge ─── */
  .order-history__status {
    display: inline-block;
    font-size: 0.72rem;
    padding: 3px 10px;
    letter-spacing: 0.03em;
    border-radius: 2px;
  }

  .order-history__status--paid,
  .order-history__status--fulfilled,
  .order-history__status--delivered { background: #eef5f0; color: #2a6b40; }

  .order-history__status--pending,
  .order-history__status--unfulfilled,
  .order-history__status--partial   { background: #fff8e6; color: #7d5700; }

  .order-history__status--refunded,
  .order-history__status--returned  { background: #f0f4ff; color: #1a3a8d; }

  .order-history__status--cancelled,
  .order-history__status--voided    { background: #f5f5f5; color: #666; }

  .order-history__status--in-transit { background: #e6f4ff; color: #0050a0; }

  /* ─── Load more ─── */
  .order-history__load-more-wrap {
    text-align: center;
    margin-top: 32px;
  }

  .order-history__load-more-btn {
    padding: 12px 40px;
    background: transparent;
    border: 1px solid var(--color-foreground, #000);
    font-size: 0.82rem;
    font-family: inherit;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .order-history__load-more-btn:hover {
    background: var(--color-foreground, #000);
    color: #fff;
  }

  .order-history__load-more-btn.is-loading {
    opacity: 0.6;
    cursor: wait;
  }



  /* ================================================================
     Order Detail
     ================================================================ */

  .order-detail {
    max-width: 640px;
  }

  .order-detail__back {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    color: #666;
    padding: 0;
    margin-bottom: 24px;
    letter-spacing: 0.04em;
    text-decoration: underline;
  }

  .order-detail__back:hover { color: #000; }

  .order-detail__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }

  .order-detail__number {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  .order-detail__date {
    font-size: 0.75rem;
    color: #888;
  }

  .order-detail__status {
    font-size: 0.72rem;
    padding: 3px 10px;
    background: #f0f0f0;
    border-radius: 2px;
  }

  .order-detail__status--shipped    { background: #e8f0fe; color: #1a56c4; }
  .order-detail__status--processing { background: #fef9e7; color: #8a6d00; }
  .order-detail__status--cancelled  { background: #fdecea; color: #c0392b; }
  .order-detail__status--returned   { background: #f3e8fd; color: #7b2ca8; }

  .order-detail__section-title {
    font-size: 0.8rem;
    font-weight: 600;
    margin: 0 0 14px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .order-detail__items,
  .order-detail__totals,
  .order-detail__shipping {
    border-top: 1px solid #e0e0e0;
    padding-top: 20px;
    margin-bottom: 24px;
  }

  .order-detail__item {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
    align-items: flex-start;
  }

  .order-detail__item-img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border: 1px solid #f0f0f0;
    flex-shrink: 0;
  }

  .order-detail__item-img--placeholder { background: #f5f5f5; }

  .order-detail__item-info { flex: 1; }

  .order-detail__item-title {
    font-size: 0.82rem;
    font-weight: 500;
    margin: 0 0 4px;
  }

  .order-detail__item-variant,
  .order-detail__item-qty {
    font-size: 0.74rem;
    color: #888;
    margin: 0 0 2px;
  }

  .order-detail__item-price {
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .order-detail__total-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    padding: 5px 0;
  }

  .order-detail__total-row--grand {
    font-weight: 600;
    border-top: 1px solid #e0e0e0;
    margin-top: 6px;
    padding-top: 10px;
    font-size: 0.9rem;
  }

  .order-detail__address {
    font-size: 0.8rem;
    line-height: 1.7;
    font-style: normal;
  }

  .order-detail__loading,
  .order-detail__error {
    font-size: 0.85rem;
    color: #888;
    padding: 20px 0;
  }

  .order-detail__error { color: #c0392b; }

  .account-view__error {
    font-size: 0.85rem;
    color: #c0392b;
    padding: 20px 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Account",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
