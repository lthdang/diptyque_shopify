{%- comment -%}
  Order History page.
  Uses the shared my-account-layout snippet for sidebar + outer layout.
{%- endcomment -%}

{%- capture oh_content -%}
<div id="order-history-container"></div>
{%- endcapture -%}

{%- render 'my-account-layout', active_nav: 'orders', content: oh_content -%}

{% comment %} ─── ① Config ─── {% endcomment %}
<script id="oh-config" type="application/json">
  {
    "storefrontEndpoint": "https://{{ shop.permanent_domain }}/api/2026-04/graphql.json",
    "storefrontToken":    {{ settings.storefront_access_token | json }},
    "apiBase":            {{ settings.be_api_base_url | json }}
  }
</script>

{% comment %} ─── ② i18n ─── {% endcomment %}
<script id="oh-i18n" type="application/json">
  {
    "loading":        {{ 'custom_account.loading'         | t | json }},
    "load_more":      {{ 'custom_account.order_load_more' | t | json }},
    "load_error":     {{ 'custom_account.order_load_error'| t | json }},
    "no_orders":      {{ 'custom_account.no_orders'       | t | json }},
    "start_shopping": {{ 'custom_account.start_shopping'  | t | json }},
    "view_details":   {{ 'custom_account.order_view_details' | t | json }},
    "tab_all":        {{ 'custom_account.order_tab_all'      | t | json }},
    "tab_processing": {{ 'custom_account.order_tab_processing' | t | json }},
    "tab_shipped":    {{ 'custom_account.order_tab_shipped'   | t | json }},
    "tab_cancelled":  {{ 'custom_account.order_tab_cancelled' | t | json }},
    "tab_returned":   {{ 'custom_account.order_tab_returned'  | t | json }}
  }
</script>

{% comment %} ─── ③ Payment gateways (Liquid object — not available on Storefront API) ─── {% endcomment %}
<script id="oh-payment-gateways" type="application/json">
  {
    {% for order in customer.orders limit: 250 %}
      "gid://shopify/Order/{{ order.id }}": {{ order.payment_gateway | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

{% comment %} ─── ③ Bundled JS ─── {% endcomment %}
<script src="{{ 'account-order-history.bundle.js' | asset_url }}" defer></script>

{% stylesheet %}
  /* ===== Order History — section-specific styles ===== */

  /* ─── Tabs ─── */
  .order-history__tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid #e6e6e6;
    margin-bottom: 24px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .order-history__tabs::-webkit-scrollbar { display: none; }

  .order-history__tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 16px;
    font-size: 0.8rem;
    font-family: inherit;
    letter-spacing: 0.02em;
    cursor: pointer;
    color: #999;
    white-space: nowrap;
    margin-bottom: -1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .order-history__tab.is-active {
    color: var(--color-foreground, #000);
    border-bottom-color: var(--color-foreground, #000);
  }

  .order-history__tab:hover { color: var(--color-foreground, #000); }

  .order-history__tab-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    margin-left: 6px;
    border-radius: 9px;
    background: #e5e5e5;
    color: #666;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1;
    vertical-align: middle;
    transition: background 0.2s, color 0.2s;
  }

  .order-history__tab.is-active .order-history__tab-count {
    background: var(--color-foreground, #000);
    color: #fff;
  }

  /* ─── Order list ─── */
  .order-history__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ─── Order card ─── */
  .order-history__card {
    display: flex;
    align-items: center;
    flex-direction: column;
  }

  /* ─── Product thumbnail ─── */
  .order-history__card-image {
    position: relative;
    flex-shrink: 0;
    width: 80px;
    height: 80px;
  }

  .order-history__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .order-history__img-placeholder {
    width: 100%;
    height: 100%;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ccc;
  }

  .order-history__img-more {
    position: absolute;
    bottom: 4px;
    right: 4px;
    background: rgba(0,0,0,0.6);
    color: #fff;
    font-size: 0.65rem;
    padding: 2px 5px;
    border-radius: 2px;
    line-height: 1;
  }

  /* ─── Card info ─── */
  .order-history__card-info {
    flex: 1;
    min-width: 0;
  }

  .order-history__card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .order-history__order-number {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .order-history__date,
  .order-history__total {
    font-size: 0.8rem;
    color: #666;
    margin: 0 0 4px;
  }

  .order-history__total {
    font-size: 0.85rem;
    color: var(--color-foreground, #000);
    font-weight: 500;
  }

  /* ─── Status badge ─── */
  .order-history__status {
    display: inline-block;
    font-size: 0.7rem;
    padding: 3px 10px;
    letter-spacing: 0.03em;
    border-radius: 2px;
  }

  .order-history__status--paid,
  .order-history__status--fulfilled,
  .order-history__status--delivered { background: #eef5f0; color: #2a6b40; }

  .order-history__status--pending,
  .order-history__status--unfulfilled,
  .order-history__status--partial   { background: #fff8e6; color: #7d5700; }

  .order-history__status--refunded,
  .order-history__status--returned  { background: #f0f4ff; color: #1a3a8d; }

  .order-history__status--cancelled,
  .order-history__status--voided    { background: #f5f5f5; color: #666; }

  .order-history__status--in-transit { background: #e6f4ff; color: #0050a0; }

  /* ─── Detail link ─── */
  .order-history__card-actions {
    flex-shrink: 0;
  }

  .order-history__detail-link {
    font-size: 0.78rem;
    white-space: nowrap;
  }

  /* ─── Receipt + Reorder buttons ─── */
  .order-history__detail-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid #eee;
    flex-wrap: wrap;
  }

  .order-history__receipt-btn {
    background: var(--color-foreground, #000);
    color: #fff;
    border: 1px solid var(--color-foreground, #000);
    padding: 10px 20px;
    font-size: 0.78rem;
    font-family: inherit;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .order-history__receipt-btn:hover {
    background: transparent;
    color: var(--color-foreground, #000);
  }

  /* ─── Reorder button ─── */
  .order-history__reorder-link {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.78rem;
    font-family: inherit;
    text-decoration: underline;
    cursor: pointer;
    color: var(--color-foreground, #000);
    transition: opacity 0.2s;
  }

  .order-history__reorder-link:hover {
    opacity: 0.65;
  }

  .order-history__reorder-link.is-loading {
    opacity: 0.45;
    cursor: wait;
    text-decoration: none;
  }

  /* ─── Load more ─── */
  .order-history__load-more-wrap {
    text-align: center;
    margin-top: 32px;
  }

  .order-history__load-more-btn {
    padding: 12px 40px;
    background: transparent;
    border: 1px solid var(--color-foreground, #000);
    font-size: 0.82rem;
    font-family: inherit;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .order-history__load-more-btn:hover {
    background: var(--color-foreground, #000);
    color: #fff;
  }

  .order-history__load-more-btn.is-loading {
    opacity: 0.6;
    cursor: wait;
  }

  /* ─── Responsive ─── */
  @media screen and (max-width: 749px) {
    .order-history__card { gap: 12px; }
    .order-history__card-image { width: 64px; height: 64px; }
    .order-history__card-actions { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Order History",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
